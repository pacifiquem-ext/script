{
  "name": "@script/server",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "swc src -d dist --source-maps --config-file .swcrc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "worker": "node -r @swc-node/register src/worker/index.ts",
    "worker:start": "node dist/src/worker/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@prisma/client": "^5.22.0",
    "@script/shared": "workspace:*",
    "argon2": "^0.44.0",
    "bullmq": "^5.79.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.5.0",
    "resend": "^6.17.1",
    "tesseract.js": "^7.0.0",
    "uploadthing": "^7.7.4",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@swc-node/register": "^1.10.9",
    "@swc/cli": "^0.5.0",
    "@swc/core": "^1.9.2",
    "@types/node": "^22.9.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/xlsx": "^0.0.36",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.9.0",
    "nodemon": "^3.1.7",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vitest": "^2.1.4"
  },
  "prisma": {
    "seed": "node -r @swc-node/register prisma/seed.ts"
  }
}
