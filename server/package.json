  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@swc-node/register": "^1.10.9",
    "@swc/cli": "^0.5.0",
    "@swc/core": "^1.9.2",
    "@types/node": "^22.9.0",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.9.0",
    "nodemon": "^3.1.7",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
