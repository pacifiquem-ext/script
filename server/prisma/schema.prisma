generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum WorkspaceRole {
  owner
  admin
  member
}

enum DocumentStatus {
  pending
  processing
  ready
  failed
}

enum DocumentSource {
  local
  url
  drive
  dropbox
  onedrive
  box
}

enum MessageRole {
  user
  assistant
}

enum IntegrationProvider {
  drive
  dropbox
  onedrive
  box
}

enum IntegrationStatus {
  connected
  disconnected
  error
}

enum OtpPurpose {
  signup_verify
  password_reset
  login
}

enum WorkspacePlan {
  free
  pro
  team
}

enum CreditLedgerReason {
  signup_grant
  admin_adjust
  chat_usage
  ingestion_usage
  embedding_backfill
  purchase_pending
}

enum DocumentVersionChangeReason {
  upload
  reprocess
  rollback
  backfill
  import
}

enum MemorySourceType {
  document
  meeting
  channel
  work_item
  workflow
}

enum WorkflowStatus {
  draft
  published
}

enum WorkflowStepStatus {
  pending
  done
  skipped
}

enum WorkflowRunStatus {
  pending
  in_progress
  completed
}

enum MeetingStatus {
  pending
  processing
  ready
  failed
}

enum ResourceVisibility {
  workspace
  restricted
}

enum ResourceKind {
  document
  meeting
  channel
  work_item
  work_project
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  avatarStorageKey String?
  emailVerifiedAt DateTime?
  lastWorkspaceId String?
  preferences     Json      @default("{}")
  /// password | oidc — set when user last authenticated via SSO
  authProvider    String    @default("password")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lastWorkspace   Workspace?        @relation("UserLastWorkspace", fields: [lastWorkspaceId], references: [id], onDelete: SetNull)
  memberships     WorkspaceMember[]
  refreshTokens   RefreshToken[]
  emailOtps       EmailOtp[]
  documents       Document[]        @relation("DocumentCreatedBy")
  conversations   Conversation[]
  apiKeys         ApiKey[]          @relation("ApiKeyCreatedBy")
  creditLedger    CreditLedgerEntry[]
  invitesSent     WorkspaceInvite[] @relation("InviteInvitedBy")
  auditEvents     AuditEvent[]      @relation("AuditActor")
  workflowsCreated Workflow[]       @relation("WorkflowCreatedBy")
  workflowVersionsCreated WorkflowVersion[] @relation("WorkflowVersionCreatedBy")
  workflowRuns    WorkflowRun[]     @relation("WorkflowRunAssignee")
  workflowStepsCompleted WorkflowStepState[] @relation("WorkflowStepCompletedBy")
  browserSessionVaults BrowserSessionVault[]
  writeConfirmations   AgentWriteConfirmation[]

  @@index([lastWorkspaceId])
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @unique
  userAgent         String?
  ip                String?
  createdAt         DateTime  @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([userId])
  @@index([expiresAt])
}

model EmailOtp {
  id         String     @id @default(cuid())
  userId     String?
  email      String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([expiresAt])
}

model Workspace {
  id        String        @id @default(cuid())
  name      String
  plan      WorkspacePlan @default(free)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  members            WorkspaceMember[]
  folders            Folder[]
  documents          Document[]
  documentVersions   DocumentVersion[]
  documentChunks     DocumentChunk[]
  memorySources      MemorySource[]
  memoryChunks       MemoryChunk[]
  meetings           Meeting[]
  meetingCommitments MeetingCommitment[]
  meetingConnectors  MeetingConnector[]
  conversations      Conversation[]
  integrations       Integration[]
  apiKeys            ApiKey[]
  creditBalance      CreditBalance?
  creditLedger       CreditLedgerEntry[]
  lastWorkspaceUsers User[] @relation("UserLastWorkspace")
  invites            WorkspaceInvite[]
  auditEvents        AuditEvent[]
  agentToolCalls     AgentToolCall[]
  resourcePrincipals ResourcePrincipal[]
  personIdentities   PersonIdentity[]
  systemConnectors   SystemConnector[]
  workProjects       WorkProject[]
  workItems          WorkItem[]
  slackInstalls      SlackInstall[]
  channelBindings    ChannelBinding[]
  workflows          Workflow[]
  workflowVersions   WorkflowVersion[]
  workflowRuns       WorkflowRun[]
  workflowStepStates WorkflowStepState[]
  browserSessionVaults BrowserSessionVault[]
  writeConfirmations   AgentWriteConfirmation[]

  /// Org retention hint (days). Null = use install default / unlimited. Documented in runbooks.
  retentionDays      Int?
}

model WorkspaceMember {
  id             String        @id @default(cuid())
  workspaceId    String
  userId         String
  role           WorkspaceRole @default(member)
  creditShare    Int?
  /// Max document/folder clearance this member may read (0 = public library).
  clearanceLevel Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Folder {
  id             String   @id @default(cuid())
  workspaceId    String
  parentId       String?
  name           String
  clearanceLevel Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Folder[]   @relation("FolderTree")
  documents Document[]

  @@index([workspaceId, parentId])
}

/// Install-scoped signed activation (Org-P7). Singleton id = "default".
model LicenseActivation {
  id             String   @id @default("default")
  licenseId      String
  customerId     String
  seats          Int
  issuedAt       DateTime
  expiresAt      DateTime
  features       Json     @default("{}")
  keyFingerprint String
  rawClaims      Json
  activatedAt    DateTime @default(now())
  activatedById  String?
  updatedAt      DateTime @updatedAt
}

model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(member)
  tokenHash   String        @unique
  expiresAt   DateTime
  invitedById String
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InviteInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@index([expiresAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String?
  actorUserId String?
  action      String
  targetType  String?
  targetId    String?
  metadata    Json     @default("{}")
  ip          String?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor     User?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model Document {
  id                  String         @id @default(cuid())
  workspaceId         String
  folderId            String?
  name                String
  mimeType            String
  byteSize            Int
  storageKey          String
  source              DocumentSource
  sourceUrl           String?
  /// Min member clearance required to see this document (Org-P9b / ADR 0014).
  clearanceLevel      Int                @default(0)
  visibility          ResourceVisibility @default(workspace)
  /// Retrieval-facing status: ready when currentVersion is ready. Stays ready while a
  /// newer version is processing so chat keeps serving the last good version.
  status              DocumentStatus @default(pending)
  processingPhase     String?
  failureReason       String?
  pageCount           Int?
  extractedText       String?        @db.Text
  /// One-line library inventory blurb (from current version); used by list_library tools.
  summary             String?        @db.Text
  embeddingModel      String?
  embeddingDimensions Int?
  /// SHA-256 of current version bytes (workspace upload dedup).
  contentHash         String?
  currentVersionId    String?        @unique
  processingVersionId String?        @unique
  createdById         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  processedAt         DateTime?

  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder              Folder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdBy           User?              @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  versions            DocumentVersion[]  @relation("DocumentVersions")
  currentVersion      DocumentVersion?   @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  processingVersion   DocumentVersion?   @relation("DocumentProcessingVersion", fields: [processingVersionId], references: [id], onDelete: SetNull)
  chunks              DocumentChunk[]
  mentions            MessageMention[]
  memorySource        MemorySource?

  @@index([workspaceId, status])
  @@index([workspaceId, folderId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, contentHash])
  /// Cloud re-import / URL identity — same sourceUrl attaches a new version, not a sibling Document.
  @@index([workspaceId, sourceUrl])
  @@index([createdById])
  @@index([embeddingModel, embeddingDimensions, status])
}

/// Immutable content snapshot. Ready/failed versions are never rewritten in place;
/// only pending/processing rows mutate while ingestion runs. Rollback creates a new version.
model DocumentVersion {
  id                    String                       @id @default(cuid())
  documentId            String
  workspaceId           String
  versionNumber         Int
  status                DocumentStatus               @default(pending)
  processingPhase       String?
  failureReason         String?
  mimeType              String
  byteSize              Int
  storageKey            String
  contentHash           String?
  extractedText         String?                      @db.Text
  summary               String?                      @db.Text
  pageCount             Int?
  embeddingModel        String?
  embeddingDimensions   Int?
  changeReason          DocumentVersionChangeReason
  restoredFromVersionId String?
  createdById           String?
  createdAt             DateTime                     @default(now())
  processedAt           DateTime?
  supersededAt          DateTime?

  document       Document         @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  restoredFrom   DocumentVersion? @relation("VersionRestore", fields: [restoredFromVersionId], references: [id], onDelete: SetNull)
  restorations   DocumentVersion[] @relation("VersionRestore")
  currentFor     Document?        @relation("DocumentCurrentVersion")
  processingFor  Document?        @relation("DocumentProcessingVersion")
  chunks         DocumentChunk[]

  @@unique([documentId, versionNumber])
  @@index([workspaceId, contentHash])
  @@index([documentId, status])
  @@index([workspaceId, documentId])
}

model DocumentChunk {
  id                String                       @id @default(cuid())
  documentId        String
  documentVersionId String
  workspaceId       String
  position          Int
  content           String                       @db.Text
  startOffset       Int?
  endOffset         Int?
  pageNumber        Int?
  embedding         Unsupported("vector(1024)")?
  createdAt         DateTime                     @default(now())

  document  Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([documentVersionId, position])
  @@index([workspaceId, documentId])
  @@index([documentId])
  @@index([documentVersionId])
}

/// Polymorphic memory identity (ADR 0012). Document, meeting, channel, work_item plug in here.
model MemorySource {
  id          String           @id @default(cuid())
  workspaceId String
  type        MemorySourceType
  title       String
  documentId  String?          @unique
  meetingId   String?          @unique
  externalKey String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document  Document?     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  meeting   Meeting?      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  chunks    MemoryChunk[]

  @@unique([workspaceId, type, externalKey])
  @@index([workspaceId, type])
}

/// Unified embedded segment for retrieval across source types (ADR 0012).
model MemoryChunk {
  id                String                       @id @default(cuid())
  memorySourceId    String
  workspaceId       String
  sourceType        MemorySourceType
  position          Int
  content           String                       @db.Text
  embedding         Unsupported("vector(1024)")?
  documentId        String?
  documentVersionId String?
  meetingId         String?
  startOffset       Int?
  endOffset         Int?
  pageNumber        Int?
  speaker           String?
  startMs           Int?
  endMs             Int?
  /// Provider message/issue id (Slack ts, GitHub issue number, etc.) for delete/update.
  externalId        String?
  createdAt         DateTime                     @default(now())

  memorySource MemorySource @relation(fields: [memorySourceId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meeting      Meeting?     @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([memorySourceId, position])
  @@index([workspaceId, sourceType])
  @@index([documentId])
  @@index([documentVersionId])
  @@index([meetingId])
  @@index([workspaceId, sourceType, externalId])
}

model Meeting {
  id               String             @id @default(cuid())
  workspaceId      String
  title            String
  summary          String?            @db.Text
  transcriptText   String?            @db.Text
  startedAt        DateTime?
  endedAt          DateTime?
  sourceProvider   String             @default("fireflies")
  sourceExternalId String?
  sourceUrl        String?
  participants     Json               @default("[]")
  status           MeetingStatus      @default(pending)
  failureReason    String?
  clearanceLevel   Int                @default(0)
  visibility       ResourceVisibility @default(workspace)
  createdById      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  processedAt      DateTime?

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memorySource MemorySource?
  chunks       MemoryChunk[]
  commitments  MeetingCommitment[]

  @@index([workspaceId, startedAt])
  @@index([workspaceId, status])
  @@index([workspaceId, sourceProvider, sourceExternalId])
}

/// Explicit allow-list when resource.visibility = restricted (ADR 0014).
model ResourcePrincipal {
  id           String       @id @default(cuid())
  workspaceId  String
  resourceKind ResourceKind
  resourceId   String
  userId       String
  createdAt    DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, resourceKind, resourceId, userId])
  @@index([workspaceId, userId])
  @@index([resourceKind, resourceId])
}

/// Maps external platform identities to script users (ADR 0014 X3).
model PersonIdentity {
  id          String   @id @default(cuid())
  workspaceId String
  provider    String
  externalId  String
  userId      String?
  email       String?
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId, email])
  @@index([workspaceId, userId])
}

/// Work-system / messaging connector install (ADR 0015) — not file OAuth Integration.
model SystemConnector {
  id                   String    @id @default(cuid())
  workspaceId          String
  provider             String
  encryptedCredentials String    @db.Text
  scopes               Json      @default("[]")
  status               String    @default("connected")
  consentAt            DateTime?
  installedById        String?
  lastSyncAt           DateTime?
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  WorkProject[]

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

model WorkProject {
  id               String             @id @default(cuid())
  workspaceId      String
  connectorId      String
  externalId       String
  name             String
  description      String?            @db.Text
  url              String?
  clearanceLevel   Int                @default(0)
  visibility       ResourceVisibility @default(workspace)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connector SystemConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  items     WorkItem[]

  @@unique([connectorId, externalId])
  @@index([workspaceId])
}

model WorkItem {
  id                   String             @id @default(cuid())
  workspaceId          String
  projectId            String?
  externalId           String
  title                String
  body                 String?            @db.Text
  state                String             @default("open")
  assigneeExternalId   String?
  assigneeUserId       String?
  url                  String?
  clearanceLevel       Int                @default(0)
  visibility           ResourceVisibility @default(workspace)
  externalUpdatedAt    DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   WorkProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, externalId])
  @@index([workspaceId, state])
  @@index([projectId])
  @@index([assigneeUserId])
}

model SlackInstall {
  id                String    @id @default(cuid())
  workspaceId       String
  teamId            String
  teamName          String?
  encryptedBotToken String    @db.Text
  botUserId         String?
  scopes            Json      @default("[]")
  installedById     String?
  consentAt         DateTime?
  status            String    @default("connected")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bindings  ChannelBinding[]

  @@unique([workspaceId])
  @@unique([teamId])
  @@index([workspaceId])
}

model ChannelBinding {
  id             String             @id @default(cuid())
  workspaceId    String
  slackInstallId String
  channelId      String
  channelName    String?
  boundByUserId  String?
  retentionDays  Int?
  announcedAt    DateTime?
  clearanceLevel Int                @default(0)
  visibility     ResourceVisibility @default(workspace)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slackInstall SlackInstall @relation(fields: [slackInstallId], references: [id], onDelete: Cascade)

  @@unique([slackInstallId, channelId])
  @@index([workspaceId])
}

/// Markdown-authored guided process catalog entry (ADR 0018 / C7).
model Workflow {
  id               String         @id @default(cuid())
  workspaceId      String
  name             String
  status           WorkflowStatus @default(draft)
  currentVersionId String?        @unique
  createdById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User?             @relation("WorkflowCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  currentVersion WorkflowVersion?  @relation("WorkflowCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       WorkflowVersion[] @relation("WorkflowVersions")
  runs           WorkflowRun[]

  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
  @@index([createdById])
}

/// Append-only snapshot of workflow markdown + parsed step tree (ADR 0018).
model WorkflowVersion {
  id            String    @id @default(cuid())
  workspaceId   String
  workflowId    String
  versionNumber Int
  markdown      String    @db.Text
  title         String
  stepsJson     Json
  /// Set after a successful agent verification run of this markdown (required before publish).
  verifiedAt    DateTime?
  verifiedRunId String?
  createdById   String?
  createdAt     DateTime  @default(now())

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow   Workflow      @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  createdBy  User?         @relation("WorkflowVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  currentFor Workflow?     @relation("WorkflowCurrentVersion")
  runs       WorkflowRun[]

  @@unique([workflowId, versionNumber])
  @@index([workspaceId, workflowId])
  @@index([workflowId])
}

/// One assignee’s traversal of one pinned WorkflowVersion (ADR 0018).
model WorkflowRun {
  id                String            @id @default(cuid())
  workspaceId       String
  workflowId        String
  workflowVersionId String
  assigneeUserId    String
  status            WorkflowRunStatus @default(pending)
  /// idle | running | completed | failed — agent execution lifecycle (distinct from checklist status).
  agentStatus       String            @default("idle")
  /// Short human summary of last agent pass (e.g. "3 steps still pending — needs login").
  agentSummary      String?
  /// Append-only activity log for the runner Activity panel (status, reasoning, tools, steps).
  executionLogJson  Json?
  startedAt         DateTime          @default(now())
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow        Workflow            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion WorkflowVersion     @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  assignee        User                @relation("WorkflowRunAssignee", fields: [assigneeUserId], references: [id], onDelete: Cascade)
  steps           WorkflowStepState[]

  @@index([workspaceId, assigneeUserId, status])
  @@index([workflowId, assigneeUserId])
  @@index([assigneeUserId, updatedAt])
  @@index([workflowVersionId])
}

/// Per-step progress on a run (ADR 0018).
model WorkflowStepState {
  id            String             @id @default(cuid())
  workspaceId   String
  runId         String
  stepKey       String
  label         String
  status        WorkflowStepStatus @default(pending)
  completedAt   DateTime?
  completedById String?
  /// Evidence for completion: { method, summary, finalUrl?, actions? } — agent browser preferred over self-attest.
  evidenceJson  Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run         WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  completedBy User?       @relation("WorkflowStepCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([runId, stepKey])
  @@index([workspaceId, runId])
  @@index([runId, status])
}

/// Per-workspace meetings connector credentials (Fireflies API key, etc.).
model MeetingConnector {
  id                   String   @id @default(cuid())
  workspaceId          String
  provider             String
  encryptedCredentials String   @db.Text
  webhookSecretHash    String?
  status               String   @default("connected")
  lastSyncAt           DateTime?
  lastError            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

model MeetingCommitment {
  id            String    @id @default(cuid())
  meetingId     String
  workspaceId   String
  text          String    @db.Text
  ownerLabel    String?
  ownerUserId   String?
  dueAt         DateTime?
  sourceStartMs Int?
  createdAt     DateTime  @default(now())

  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, meetingId])
  @@index([meetingId])
  @@index([ownerUserId])
}

/// Encrypted Playwright storageState JSON for logged-in workflow browser runs (P5.8b).
model BrowserSessionVault {
  id                    String    @id @default(cuid())
  workspaceId           String
  userId                String
  name                  String
  encryptedStorageState String    @db.Text
  lastUsedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, name])
  @@index([workspaceId, userId])
}

/// HITL confirm token for agent write tools (P5.6b / Phase M.6).
model AgentWriteConfirmation {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  toolName    String
  payloadJson Json
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
  @@index([expiresAt])
}

/// Persisted agent tool audit (Phase 1 / T0.3). Complements Pino agent_tool_audit.
model AgentToolCall {
  id             String   @id @default(cuid())
  workspaceId    String
  userId         String?
  tool           String
  ok             Boolean
  durationMs     Int
  error          String?
  conversationId String?
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([tool, createdAt])
  @@index([userId, createdAt])
}

model Conversation {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([workspaceId, updatedAt])
  @@index([userId, updatedAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  citations      Json?
  partial        Boolean     @default(false)
  createdAt      DateTime    @default(now())

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mentions     MessageMention[]

  @@index([conversationId, createdAt])
}

model MessageMention {
  messageId  String
  documentId String

  message  Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([messageId, documentId])
  @@index([documentId])
}

model Integration {
  id                    String              @id @default(cuid())
  workspaceId           String
  provider              IntegrationProvider
  accountEmail          String?
  accessTokenEncrypted  String              @db.Text
  refreshTokenEncrypted String?             @db.Text
  tokenExpiresAt        DateTime?
  scopes                String[]            @default([])
  status                IntegrationStatus   @default(connected)
  statusMessage         String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, accountEmail])
  @@index([workspaceId, provider])
}

model ApiKey {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  keyPrefix    String
  keyHash      String    @unique
  createdById  String?
  lastUsedAt   DateTime?
  useCount     Int       @default(0)
  rateLimitRpm Int       @default(60)
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?             @relation("ApiKeyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  auditEvents ApiKeyAuditEvent[]

  @@index([workspaceId, revokedAt])
  @@index([keyPrefix])
}

model ApiKeyAuditEvent {
  id        String   @id @default(cuid())
  apiKeyId  String
  action    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, createdAt])
}

model CreditBalance {
  workspaceId String   @id
  balance     Int      @default(0)
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CreditLedgerEntry {
  id          String             @id @default(cuid())
  workspaceId String
  userId      String?
  delta       Int
  reason      CreditLedgerReason
  refType     String?
  refId       String?
  note        String?
  createdAt   DateTime           @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId])
  /// Partial unique index on negative usage rows enforced in SQL migration
  /// CreditLedgerEntry_usage_idempotency_uidx (workspaceId, reason, refType, refId)
}
