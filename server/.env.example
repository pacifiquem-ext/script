NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# SPA origin(s). Comma-separated allowlist — include every Vite host:port you use locally.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Neon Postgres (https://neon.tech)
DATABASE_URL="postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/script?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/script?sslmode=require"

# Auth (access JWT signing). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Encrypt OAuth provider tokens at rest (required in production). Same generation command as JWT_SECRET.
TOKEN_ENCRYPTION_KEY=

# File storage driver: "uploadthing" (managed, default) or "s3" (any S3-compatible store)
STORAGE_DRIVER=uploadthing
UPLOADTHING_TOKEN=
MAX_UPLOAD_BYTES=26214400

# Only required when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Background jobs (BullMQ). Required in production and recommended in dev.
REDIS_URL=redis://127.0.0.1:6379
# true = in-process jobs (dev/test only). Keep false when Redis is available.
ALLOW_INLINE_INGESTION=false

# AI — required for real ingestion embeddings and chat (no silent pseudo/dummy fallbacks outside tests).
# Production boot fails closed without these. Development boots without them but embed/chat endpoints return 503 until set.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Optional: agent web_search tool (https://tavily.com). Library tools work without it.
TAVILY_API_KEY=

# Org-P8 pluggable providers (ADR 0010). Defaults: anthropic + voyage.
# COMPLETION_PROVIDER=anthropic
# COMPLETION_PROVIDER=openai_compatible
# COMPLETION_BASE_URL=http://127.0.0.1:11434/v1
# COMPLETION_API_KEY=
# COMPLETION_MODEL=llama3.1
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=nomic-embed-text

# Org-P7 signed activation (ed25519). Empty public key = open-dev (unlimited seats).
# LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# LICENSE_KEY=script1....   # optional bootstrap at boot
# LICENSE_ENFORCEMENT=false

# Org-P9b OIDC SSO (all four required together)
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=http://localhost:4000/auth/sso/callback

# C3 Fireflies meetings (workspace API keys encrypted with TOKEN_ENCRYPTION_KEY)
# FIREFLIES_WEBHOOK_SECRET=  # HMAC for POST /webhooks/fireflies (X-Hub-Signature)

# C4 Slack bot (ADR 0016) — bot token stored per workspace after install
# SLACK_SIGNING_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# Slack OAuth v2 Redirect URL (register this exact URI on api.slack.com → OAuth & Permissions):
#   http://localhost:4000/slack/oauth/callback
# Origin is derived from OAUTH_REDIRECT_URL when set; path is always /slack/oauth/callback.

# Email (Resend). When unset in development, auth modules may log OTPs instead of sending.
RESEND_API_KEY=
EMAIL_FROM=

# Optional hard-PDF/scan extraction escape hatch
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=

# -----------------------------------------------------------------------------
# Cloud OAuth (Settings → Integrations / Library cloud import)
# Leave empty until you create apps.
# Redirect URI for every provider must match OAUTH_REDIRECT_URL exactly.
# -----------------------------------------------------------------------------
OAUTH_REDIRECT_URL=http://localhost:4000/integrations/oauth/callback
APP_PUBLIC_URL=http://localhost:5173
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
