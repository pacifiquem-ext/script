NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Neon Postgres (https://neon.tech) — create a project, then copy both connection
# strings from the Neon dashboard.
# DATABASE_URL: pooled connection (via PgBouncer) — used by the app at runtime.
# DIRECT_URL: unpooled connection — used by Prisma Migrate, needs a direct connection.
DATABASE_URL="postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/script?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/script?sslmode=require"

# File storage driver: "uploadthing" (managed, default) or "s3" (self-hosted,
# e.g. Garage — see docs/storage.md)
STORAGE_DRIVER=uploadthing
UPLOADTHING_TOKEN=

# Only required when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
