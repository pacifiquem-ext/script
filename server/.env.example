NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Neon Postgres (https://neon.tech)
DATABASE_URL="postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/script?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/script?sslmode=require"

# Auth (access JWT signing). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Encrypt OAuth provider tokens at rest (required in production). Same generation command as JWT_SECRET.
TOKEN_ENCRYPTION_KEY=

# File storage driver: "uploadthing" (managed, default) or "s3" (self-hosted, e.g. Garage — see docs/storage.md)
STORAGE_DRIVER=uploadthing
UPLOADTHING_TOKEN=
MAX_UPLOAD_BYTES=26214400

# Only required when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Background jobs (BullMQ). Required in production. In development, set REDIS_URL for the worker,
# or set ALLOW_INLINE_INGESTION=true to process jobs in-process (still requires VOYAGE_API_KEY).
REDIS_URL=
ALLOW_INLINE_INGESTION=false

# AI — required for real ingestion embeddings and chat (no silent pseudo/dummy fallbacks outside tests).
# Production boot fails closed without these. Development boots without them but embed/chat endpoints return 503 until set.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Email (Resend). When unset in development, auth modules may log OTPs instead of sending.
RESEND_API_KEY=
EMAIL_FROM=

# Optional hard-PDF/scan extraction escape hatch
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=
